# Active server-side profile: sandbox | production
ONERWAY_PROFILE=sandbox

# Sandbox canonical API origin and current replaceable Web SDK entry
ONERWAY_SANDBOX_BASE_URL=https://sandbox-acq.onerway.com
ONERWAY_SANDBOX_SDK_URL=https://sandbox-checkout-sdk.onerway.com/v4/latest/onerway.js
ONERWAY_SHOWCASE_ORIGIN=https://your-showcase.example
ONERWAY_SANDBOX_NOTIFY_URL=https://your-showcase.example/api/webhooks/onerway/payment
# Keep false for direct delivery. Set true only for an approved Pages HTTPS relay ending in /onerway/payment.
ONERWAY_SANDBOX_NOTIFY_RELAY=false
ONERWAY_SANDBOX_TRANSACTION_IP=
ONERWAY_SANDBOX_MERCHANT_NO=
ONERWAY_SANDBOX_APP_ID=
ONERWAY_SANDBOX_SECRET=

# Production stays locked in M0 even when its profile can be displayed.
ONERWAY_PRODUCTION_ENABLED=false
ONERWAY_PRODUCTION_BASE_URL=https://acq.onerway.com
ONERWAY_PRODUCTION_SDK_URL=
ONERWAY_PRODUCTION_NOTIFY_URL=
ONERWAY_PRODUCTION_MERCHANT_NO=
ONERWAY_PRODUCTION_APP_ID=
ONERWAY_PRODUCTION_SECRET=

# Vercel-managed Neon. Use the unpooled URL only for explicit migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel only: "apply" with VERCEL_ENV=production and "skip" with VERCEL_ENV=preview.
PAYMENT_MIGRATION_MODE=

# Dedicated disposable test database with the ci guard marker. Never reuse DATABASE_URL.
TEST_DATABASE_URL=
# Set to "isolated" only after verifying the URL targets disposable test storage.
PAYMENT_TEST_DATABASE_CONFIRM=

# Internal routes fail closed until these independent server-only tokens exist.
PAYMENT_DIAGNOSTIC_TOKEN=
CRON_SECRET=

# Never expose Onerway configuration through NUXT_PUBLIC_* or commit a populated env file.
